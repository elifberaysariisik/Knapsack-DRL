{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Knapsack-DRL: Paper experiment",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "run_experiment.py",
        "all",
        "--nodes",
        "30",
        "--sigma-e2",
        "0.002",
        "--train-episodes",
        "10000",
        "--test-episodes",
        "500",
        "--output",
        "artifacts"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MPLBACKEND": "Agg",
          "MPLCONFIGDIR": "${workspaceFolder}/work/matplotlib-cache",
          "XDG_CACHE_HOME": "${workspaceFolder}/work/cache"
        }
      },
      "problemMatcher": []
    }
  ]
}
